;; Laptop Monitor (eDP-1)
(defwindow bar_0
    :monitor 0
    :geometry (geometry :x "0%"
                        :y "0%"
                        :width "100%"
                        :height "28px"
                        :anchor "top center")
    :stacking "fg"
    :exclusive true
    :focusable false
    :namespace "eww"
    (bar_layout :mon_name "eDP-1" :mon_id 0))

;; HDMI Monitor (HDMI-A-1)
(defwindow bar_1
    :monitor 1
    :geometry (geometry :x "0%"
                        :y "0%"
                        :width "100%"
                        :height "28px"
                        :anchor "top center")
    :stacking "fg"
    :exclusive true
    :focusable false
    :namespace "eww"
    (bar_layout :mon_name "HDMI-A-1" :mon_id 1))
