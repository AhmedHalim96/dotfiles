(defwidget active_clients [mon_name]
  (scroll :hscroll true
          :vscroll false
          :hexpand true
    (box :class "clients-box"
         :space-evenly false
         :spacing 0
         (for client in {mango.clients[mon_name] ?: []}
           (eventbox
            :onclick "mmsg dispatch focusid \"client,${client.id}\""
            :onmiddleclick "mmsg dispatch focusid \"client,${client.id}\" && mmsg dispatch killclient"
            :onrightclick "mmsg dispatch focusid \"client,${client.id}\" && mmsg dispatch togglemaximizescreen"
            :tooltip "${client.title}"
            :cursor "pointer"
            (box :hexpand true :class "client-item ${client.is_focused ? 'focused' : ''}"
                 (box :space-evenly false
                      :hexpand true
                      :spacing 6
                      (image :class "client-icon"
                          :path "${client.icon}"
                          :image-width 16
                          :image-height 16)
                      (label :class "client-title"
                          :text "${client.title}"
                          :limit-width 50))))))))
