;; Poll weather script every 15 minutes
(defpoll weather :interval "15m"
  `modules/bar/weather/weather.py`)

;; Weather Bar Widget using dynamically passed dynamic class
(defwidget weather_widget []
  (box :class "stat-box weather-box ${weather.temp_class}"
       :space-evenly false
       :spacing 4
       :tooltip "${weather.desc} (Feels like ${weather.feels})"
    (label :class "stat-icon weather-icon" :text "${weather.icon}")
    (label :class "stat-text weather-temp" :text "${weather.temp}")))
